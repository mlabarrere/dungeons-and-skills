{
  "name": "dungeons-and-skills",
  "version": "0.2.0-beta.1",
  "license": "MIT",
  "author": { "name": "Dungeons & Skills contributors" },
  "homepage": "https://github.com/mlabarrere/dungeons-and-skills-srd",
  "bin": { "dungeons-and-skills": "./install.mjs" },
  "files": [
    "install.mjs",
    "engine/",
    "data/*.json",
    "rules/",
    "skills/",
    "commands/",
    "AGENTS.md",
    ".claude-plugin/",
    "assets/",
    "project-mode/",
    "examples/",
    "README.md",
    "README.fr.md",
    "INSTALL.md",
    "PLATFORMS.md",
    "KNOWN_LIMITATIONS.md",
    "ATTRIBUTION.md",
    "version.json"
  ],
  "scripts": {
    "skill:build": "node scripts/build-bundles.mjs && node scripts/build-adapters.mjs",
    "skill:check": "node scripts/sync-version.mjs --check && node scripts/check-sync.mjs && node scripts/check-rule-copies.mjs && node scripts/check-skills-spec.mjs && node scripts/audit-public-catalog.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "playwright test --config playwright.config.mjs",
    "release:export": "node scripts/export-public-repository.mjs",
    "release:build": "node scripts/build-public-release.mjs"
  }
}
